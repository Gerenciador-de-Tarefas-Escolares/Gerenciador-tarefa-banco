# Copie este arquivo para ".env" e ajuste se quiser:  cp .env.example .env
# Valores só para desenvolvimento na sua máquina. Nunca use estes em produção.

DB_NOME=gerenciador_tarefas
DB_USUARIO=gerenciador
DB_SENHA=troque_esta_senha

# Só mude se a porta 5432 já estiver ocupada na sua máquina (ex.: outro Postgres instalado)
DB_PORTA=5432
